{
	"name": "@geekpresent/core",
	"version": "0.4.0",
	"description": "GeekPresent — presentation slides and long-form texts in HTML, CSS and Svelte. Shipped as source; installed from a GitHub Release tarball.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NawaMan/GeekPresent.git",
		"directory": "packages/core"
	},
	"type": "module",
	"files": ["src", "routes", "vite.js", "guide", "README.md"],
	"exports": {
		".": "./src/index.ts",
		"./vite": {
			"types": "./src/vite.ts",
			"default": "./vite.js"
		},
		"./*": "./src/*"
	},
	"dependencies": {
		"shiki": "^4.2.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0",
		"vite": "^5.3.5"
	}
}
